FUNCTION_BLOCK PROBE
  VAR_OUTPUT
    VALUE : BOOL;
  END_VAR
  VALUE := TRUE;
END_FUNCTION_BLOCK

PROGRAM MAIN
  VAR
    INPUT_BIT AT %IX0.0 : BOOL;
    OUTPUT_BIT AT %QX0.0 : BOOL;
    FAULT_INDEX AT %IB1 : BYTE;
    STATE_OUTPUT AT %QD2 : UDINT;
    ENO_BEFORE AT %QX0.2 : BOOL;
    VALUES : ARRAY[0..0] OF BOOL;
    COUNT : UDINT;
    PROBE_INSTANCE : PROBE;
  END_VAR
  VAR_EXTERNAL
    GLOBAL_INPUT : BOOL;
    GLOBAL_OUTPUT : BOOL;
  END_VAR

  IF FAULT_INDEX = 0 THEN
    OUTPUT_BIT := INPUT_BIT;
  ELSE
    OUTPUT_BIT := VALUES[FAULT_INDEX];
  END_IF;
  GLOBAL_OUTPUT := GLOBAL_INPUT;
  COUNT := COUNT + 1;
  STATE_OUTPUT := COUNT;
  ENO_BEFORE := PROBE_INSTANCE.ENO;
  PROBE_INSTANCE(EN := FALSE);
END_PROGRAM

CONFIGURATION CONFIG0
  VAR_GLOBAL
    GLOBAL_INPUT AT %IX0.1 : BOOL;
    GLOBAL_OUTPUT AT %QX0.1 : BOOL;
  END_VAR
  RESOURCE RES0 ON PLC
    TASK MAIN_TASK(INTERVAL := T#20ms, PRIORITY := 1);
    PROGRAM MAIN_INSTANCE WITH MAIN_TASK : MAIN;
  END_RESOURCE
END_CONFIGURATION
