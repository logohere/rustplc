PROGRAM FAULTY
  VAR
    VALUES : ARRAY[0..0] OF BOOL;
    INDEX : BYTE := 1;
  END_VAR
  VALUES[INDEX] := TRUE;
END_PROGRAM

PROGRAM HEALTHY
  VAR_OUTPUT
    COUNT : UDINT;
  END_VAR
  COUNT := COUNT + 1;
END_PROGRAM

CONFIGURATION CONFIG0
  RESOURCE RES0 ON PLC
    TASK FAULT_TASK(INTERVAL := T#20ms, PRIORITY := 1);
    TASK HEALTHY_TASK(INTERVAL := T#20ms, PRIORITY := 2);
    PROGRAM F WITH FAULT_TASK : FAULTY;
    PROGRAM H WITH HEALTHY_TASK : HEALTHY;
  END_RESOURCE
END_CONFIGURATION
